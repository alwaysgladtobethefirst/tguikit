{
  "name": "tgui",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "description": "React 19 component library for Telegram Mini Apps — a modern reimplementation of @telegram-apps/telegram-ui.",
  "keywords": [
    "telegram",
    "telegram-mini-apps",
    "telegram-web-app",
    "react",
    "react19",
    "component-library",
    "ui-kit",
    "design-system",
    "typescript"
  ],
  "license": "MIT",
  "author": "Vladyslav Skrynnyk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alwaysgladtobethefirst/tgui.git"
  },
  "homepage": "https://github.com/alwaysgladtobethefirst/tgui#readme",
  "bugs": "https://github.com/alwaysgladtobethefirst/tgui/issues",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --config vite.lib.config.ts && rollup -c rollup.dts.config.mjs && rm -rf dist/dts",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "size": "size-limit",
    "lint": "biome check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:package": "publint && attw --pack .",
    "release": "bun run build && changeset publish",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.11",
    "@changesets/cli": "^3.0.1",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "publint": "^0.3.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rollup": "^4.63.1",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-preserve-directives": "^1.1.3",
    "size-limit": "^13.0.3",
    "storybook": "^10.5.10",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^4.1.11"
  }
}
